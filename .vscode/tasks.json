{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tauri: Dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri", "dev"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "icon": {
        "id": "debug-start",
        "color": "terminal.ansiCyan"
      }
    },
    {
      "label": "Tauri: Build",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri", "build"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "icon": {
        "id": "package",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Frontend: Dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*http://localhost"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "icon": {
        "id": "browser",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "Rust: Check",
      "type": "shell",
      "command": "cargo",
      "args": ["check"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "icon": {
        "id": "check",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "Rust: Build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "icon": {
        "id": "tools",
        "color": "terminal.ansiMagenta"
      }
    },
    {
      "label": "Clean All",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "clean"],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "icon": {
        "id": "trash",
        "color": "terminal.ansiRed"
      }
    }
  ]
}
